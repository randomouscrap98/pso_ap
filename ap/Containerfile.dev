# Dev image: toolchain + phosg/resource_dasm only. Source is mounted, not copied,
# so builds are incremental. Use ap/build_dev.sh (build context is the repo root).
FROM ubuntu:24.04

ARG PHOSG_TARGET=master
ARG RESOURCE_DASM_TARGET=master

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 git ca-certificates make cmake g++ libasio-dev zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

COPY ap/build.sh /tmp/ap/build.sh
RUN PREFIX=/usr/local DEPS_SRC=/tmp/deps-src J=8 \
    PHOSG_REF=${PHOSG_TARGET} RESOURCE_DASM_REF=${RESOURCE_DASM_TARGET} \
    /tmp/ap/build.sh deps && rm -rf /tmp/deps-src /tmp/ap

WORKDIR /src
